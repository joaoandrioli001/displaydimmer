<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema escuro: o preto mais escuro e #202020, nunca #000000. -->
    <Color x:Key="WindowBgColor">#202020</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#202020" />
    <SolidColorBrush x:Key="WindowBorder" Color="#383838" />
    <SolidColorBrush x:Key="PanelBg" Color="#262626" />
    <SolidColorBrush x:Key="Surface" Color="#2C2C2C" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#343434" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#3B3B3B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="Divider" Color="#313131" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A6A6A6" />
    <SolidColorBrush x:Key="TextMuted" Color="#7A7A7A" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#5A96FA" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1E3A5F" />
    <SolidColorBrush x:Key="AccentText" Color="#8FB8FF" />
    <SolidColorBrush x:Key="TrackBg" Color="#3E3E3E" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#262626" />
    <SolidColorBrush x:Key="CardBorder" Color="#363636" />
    <SolidColorBrush x:Key="BadgeActiveBg" Color="#1B3A2A" />
    <SolidColorBrush x:Key="BadgeActiveText" Color="#6EE7A8" />
    <SolidColorBrush x:Key="BadgePausedBg" Color="#3A3220" />
    <SolidColorBrush x:Key="BadgePausedText" Color="#E5C07B" />
    <SolidColorBrush x:Key="DangerText" Color="#F87171" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="ShadowColor" Color="#B0000000" />

    <LinearGradientBrush x:Key="TemperatureGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F0A03C" Offset="0" />
        <GradientStop Color="#FFD3A0" Offset="0.28" />
        <GradientStop Color="#FFFFFF" Offset="0.55" />
        <GradientStop Color="#CFE0FF" Offset="0.78" />
        <GradientStop Color="#4C8DF6" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
