<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema claro com os mesmos nomes de recurso do tema escuro. -->
    <Color x:Key="WindowBgColor">#F7F7F8</Color>
    <Color x:Key="AccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#F7F7F8" />
    <SolidColorBrush x:Key="WindowBorder" Color="#D9D9DE" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#EFEFF2" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#E5E5EA" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#DBDBE1" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCDCE1" />
    <SolidColorBrush x:Key="Divider" Color="#E7E7EB" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F5F68" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A8A93" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#DCE7FF" />
    <SolidColorBrush x:Key="AccentText" Color="#1D4ED8" />
    <SolidColorBrush x:Key="TrackBg" Color="#D6D6DC" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E1E1E6" />
    <SolidColorBrush x:Key="BadgeActiveBg" Color="#DCF5E6" />
    <SolidColorBrush x:Key="BadgeActiveText" Color="#116B3C" />
    <SolidColorBrush x:Key="BadgePausedBg" Color="#FBF0D8" />
    <SolidColorBrush x:Key="BadgePausedText" Color="#8A6100" />
    <SolidColorBrush x:Key="DangerText" Color="#DC2626" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="ShadowColor" Color="#40000000" />

    <LinearGradientBrush x:Key="TemperatureGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F0A03C" Offset="0" />
        <GradientStop Color="#FFD3A0" Offset="0.28" />
        <GradientStop Color="#FFFFFF" Offset="0.55" />
        <GradientStop Color="#CFE0FF" Offset="0.78" />
        <GradientStop Color="#4C8DF6" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
