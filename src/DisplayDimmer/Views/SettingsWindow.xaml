<Window x:Class="DisplayDimmer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuracoes - Display Dimmer"
        Width="760" Height="580"
        MinWidth="680" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="12" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabecalho -->
            <Grid Grid.Row="0" Margin="18,14,12,8" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="20" Height="20" />
                    <TextBlock Text="Configuracoes" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Width="28" Height="28"
                        Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="186" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navegacao -->
                <StackPanel Grid.Column="0" Margin="12,4,6,14">
                    <RadioButton x:Name="NavGeral" Style="{StaticResource NavButton}" Content="Geral" Tag="geral"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPresets" Style="{StaticResource NavButton}" Content="Presets" Tag="presets"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAutomacoes" Style="{StaticResource NavButton}" Content="Automacoes" Tag="automacoes"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMonitores" Style="{StaticResource NavButton}" Content="Monitores e grupos" Tag="monitores"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAtalhos" Style="{StaticResource NavButton}" Content="Atalhos" Tag="atalhos"
                                 GroupName="Nav" Checked="Nav_Checked" />

                    <TextBlock x:Name="VersionText" Style="{StaticResource HintText}" Margin="12,20,12,0"
                               Text="Display Dimmer 1.0" />
                </StackPanel>

                <ScrollViewer Grid.Column="1" Margin="0,4,10,12" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,6,0">

                        <!-- ================= GERAL ================= -->
                        <StackPanel x:Name="PanelGeral" Visibility="Visible">
                            <TextBlock Text="Aparencia" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tema" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeCombo" Style="{StaticResource AppComboBox}" Width="190"
                                          HorizontalAlignment="Right" SelectionChanged="Theme_Changed">
                                    <ComboBoxItem Content="Escuro" Tag="dark" />
                                    <ComboBoxItem Content="Claro" Tag="light" />
                                    <ComboBoxItem Content="Sistema" Tag="system" />
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />

                            <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource AppCheckBox}"
                                      Content="Iniciar com o Windows" Margin="0,0,0,12"
                                      Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />

                            <CheckBox x:Name="StartMinimizedCheck" Style="{StaticResource AppCheckBox}"
                                      Content="Iniciar discretamente na bandeja" Margin="0,0,0,12"
                                      Checked="General_Changed" Unchecked="General_Changed" />

                            <TextBlock Text="Exibicao" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />

                            <CheckBox x:Name="OverlayCheck" Style="{StaticResource AppCheckBox}"
                                      Content="Escurecer por sobreposicao de software" Margin="0,0,0,4"
                                      Checked="General_Changed" Unchecked="General_Changed" />
                            <TextBlock Style="{StaticResource HintText}" Margin="27,0,0,12"
                                       Text="Usa uma camada preta por monitor em vez do gamma. Util em notebooks e monitores sem DDC/CI." />

                            <CheckBox x:Name="NativeKeysCheck" Style="{StaticResource AppCheckBox}"
                                      Content="Responder as teclas nativas de brilho do teclado" Margin="0,0,0,12"
                                      Checked="General_Changed" Unchecked="General_Changed" />

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Passo da roda na bandeja" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="TrayStepCombo" Style="{StaticResource AppComboBox}" Width="110"
                                          HorizontalAlignment="Right" SelectionChanged="TrayStep_Changed">
                                    <ComboBoxItem Content="1%" Tag="1" />
                                    <ComboBoxItem Content="2%" Tag="2" />
                                    <ComboBoxItem Content="5%" Tag="5" />
                                    <ComboBoxItem Content="10%" Tag="10" />
                                </ComboBox>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Sobre o controle de hardware" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Monitores externos compativeis usam DDC/CI (brilho e contraste reais no painel). Telas de notebook e monitores sem DDC/CI usam a rampa de gamma, que nao depende do driver." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= PRESETS ================= -->
                        <StackPanel x:Name="PanelPresets" Visibility="Collapsed">
                            <TextBlock Text="Salvar a configuracao atual" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PresetNameBox" Grid.Column="0" Style="{StaticResource AppTextBox}"
                                         ToolTip="Nome do novo preset" />
                                <Button Grid.Column="1" Content="Salvar estado atual" Style="{StaticResource AccentButton}"
                                        Margin="8,0,0,0" Height="34" Click="SavePreset_Click" />
                            </Grid>

                            <TextBlock Text="Presets salvos" Style="{StaticResource SectionTitle}" />

                            <ItemsControl x:Name="PresetsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="Aplicar" Style="{StaticResource SecondaryButton}" Height="30"
                                                            Padding="12,0" Click="ApplyPreset_Click" />
                                                    <Button Content="Excluir" Style="{StaticResource SecondaryButton}" Height="30"
                                                            Padding="12,0" Margin="8,0,0,0" Click="DeletePreset_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ================= AUTOMACOES ================= -->
                        <StackPanel x:Name="PanelAutomacoes" Visibility="Collapsed">
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Automacoes" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                                <CheckBox x:Name="AutomationsCheck" Style="{StaticResource AppCheckBox}"
                                          Content="Automacoes ativas" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Automations_Changed" Unchecked="Automations_Changed" />
                            </Grid>

                            <TextBlock Text="Agendamentos ao longo do dia" Style="{StaticResource LabelText}" Margin="0,6,0,8" />

                            <Border Style="{StaticResource Card}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ScheduleNameBox" Grid.Column="0" Style="{StaticResource AppTextBox}"
                                                 ToolTip="Nome do agendamento" />
                                        <TextBox x:Name="ScheduleTimeBox" Grid.Column="1" Style="{StaticResource AppTextBox}"
                                                 Text="08:00" Margin="8,0,0,0" ToolTip="Horario HH:mm" />
                                        <ComboBox x:Name="SchedulePresetCombo" Grid.Column="3" Style="{StaticResource AppComboBox}"
                                                  DisplayMemberPath="Name" ToolTip="Preset aplicado" />
                                        <Button Grid.Column="5" Content="Adicionar" Style="{StaticResource AccentButton}"
                                                Height="34" Padding="14,0" Click="AddSchedule_Click" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Alterar:" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                        <CheckBox x:Name="SchedParamBrightness" Style="{StaticResource AppCheckBox}" Content="Brilho"
                                                  IsChecked="True" Margin="10,0,0,0" />
                                        <CheckBox x:Name="SchedParamContrast" Style="{StaticResource AppCheckBox}" Content="Contraste"
                                                  Margin="14,0,0,0" />
                                        <CheckBox x:Name="SchedParamTemperature" Style="{StaticResource AppCheckBox}" Content="Temperatura"
                                                  Margin="14,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="SchedulesList" Margin="0,8,0,18">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                        <Border x:Name="Badge" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                                Background="{DynamicResource BadgePausedBg}">
                                                            <TextBlock x:Name="BadgeText" Text="Pausado" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BadgePausedText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource SecondaryButton}" Height="28"
                                                            Padding="10,0" Click="ToggleSchedule_Click" />
                                                    <Button Content="Excluir" Style="{StaticResource SecondaryButton}" Height="28"
                                                            Padding="10,0" Margin="6,0,0,0" Click="DeleteSchedule_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeActiveBg}" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="Ativo" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource BadgeActiveText}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Regras por aplicativo e tela cheia" Style="{StaticResource LabelText}" Margin="0,6,0,8" />

                            <Border Style="{StaticResource Card}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RuleNameBox" Grid.Column="0" Style="{StaticResource AppTextBox}"
                                                 ToolTip="Nome da regra" />
                                        <TextBox x:Name="RuleProcessBox" Grid.Column="2" Style="{StaticResource AppTextBox}"
                                                 ToolTip="Processo, por exemplo chrome" />
                                        <ComboBox x:Name="RulePresetCombo" Grid.Column="4" Style="{StaticResource AppComboBox}"
                                                  DisplayMemberPath="Name" ToolTip="Preset aplicado" />
                                        <Button Grid.Column="6" Content="Adicionar" Style="{StaticResource AccentButton}"
                                                Height="34" Padding="14,0" Click="AddRule_Click" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox x:Name="RuleFullscreenCheck" Style="{StaticResource AppCheckBox}"
                                                  Content="Somente em tela cheia" />
                                        <CheckBox x:Name="RuleRestoreCheck" Style="{StaticResource AppCheckBox}"
                                                  Content="Restaurar ao sair" IsChecked="True" Margin="18,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="RulesList" Margin="0,8,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                        <Border x:Name="Badge" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                                Background="{DynamicResource BadgePausedBg}">
                                                            <TextBlock x:Name="BadgeText" Text="Pausado" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BadgePausedText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource SecondaryButton}" Height="28"
                                                            Padding="10,0" Click="ToggleRule_Click" />
                                                    <Button Content="Excluir" Style="{StaticResource SecondaryButton}" Height="28"
                                                            Padding="10,0" Margin="6,0,0,0" Click="DeleteRule_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeActiveBg}" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="Ativo" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource BadgeActiveText}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ================= MONITORES ================= -->
                        <StackPanel x:Name="PanelMonitores" Visibility="Collapsed">
                            <TextBlock Text="Monitores detectados" Style="{StaticResource SectionTitle}" />

                            <ItemsControl x:Name="DisplaysList" Margin="0,0,0,18">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="sem DDC/CI" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" Visibility="{Binding NoDdc, Converter={StaticResource BoolToVisibility}}" />
                                                    <ComboBox Style="{StaticResource AppComboBox}" Width="150" Height="32"
                                                              SelectedIndex="{Binding ControlIndex, Mode=TwoWay}"
                                                              SelectionChanged="DisplayControl_Changed"
                                                              ToolTip="Automatico usa DDC/CI quando funciona e cai para software quando nao">
                                                        <ComboBoxItem Content="Automatico" />
                                                        <ComboBoxItem Content="DDC/CI (hardware)" />
                                                        <ComboBoxItem Content="Software (gamma)" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Grupos de monitores" Style="{StaticResource SectionTitle}" />

                            <Border Style="{StaticResource Card}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GroupNameBox" Grid.Column="0" Style="{StaticResource AppTextBox}"
                                                 ToolTip="Nome do grupo" />
                                        <Button Grid.Column="1" Content="Criar grupo" Style="{StaticResource AccentButton}"
                                                Height="34" Padding="14,0" Margin="8,0,0,0" Click="AddGroup_Click" />
                                    </Grid>
                                    <WrapPanel x:Name="GroupDisplaysPanel" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="GroupsList" Margin="0,8,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                    <TextBlock Text="{Binding DisplaySummary}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Content="Excluir" Style="{StaticResource SecondaryButton}" Height="28"
                                                        Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Click="DeleteGroup_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ================= ATALHOS ================= -->
                        <StackPanel x:Name="PanelAtalhos" Visibility="Collapsed">
                            <TextBlock Text="Atalhos globais" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                                       Text="Use combinacoes como Ctrl+Alt+Up, Ctrl+Shift+F5 ou Win+Alt+1." />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Aumentar brilho" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <TextBox x:Name="HotkeyUpBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Diminuir brilho" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <TextBox x:Name="HotkeyDownBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Abrir janela" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <TextBox x:Name="HotkeyShowBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pausar/ativar automacoes" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <TextBox x:Name="HotkeyAutomationBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                            </Grid>

                            <TextBlock Text="Atalhos por preset" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="PresetHotkeysList" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Text="{Binding Hotkey, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Salvar atalhos" Style="{StaticResource AccentButton}" Height="36"
                                    HorizontalAlignment="Left" Padding="18,0" Click="SaveHotkeys_Click" />

                            <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
