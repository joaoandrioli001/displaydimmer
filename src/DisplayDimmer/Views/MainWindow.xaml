<Window x:Class="DisplayDimmer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Dimmer"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra de titulo -->
            <Grid Grid.Row="0" Margin="16,12,10,2" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Display Dimmer" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="26" Height="26" Click="Close_Click" ToolTip="Fechar para a bandeja" />
            </Grid>

            <!-- Conteudo -->
            <StackPanel Grid.Row="1" Margin="16,10,16,16">

                <ComboBox x:Name="TargetSelector"
                          Style="{StaticResource AppComboBox}"
                          ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                          DisplayMemberPath="Name" />

                <!-- Brilho -->
                <Grid Margin="0,18,0,0">
                    <TextBlock Text="Brilho" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding BrightnessText}" Style="{StaticResource ValueText}" />
                </Grid>
                <Slider Style="{StaticResource AppSlider}" Minimum="0" Maximum="100"
                        Value="{Binding Brightness, Mode=TwoWay}" Margin="0,6,0,0"
                        AutomationProperties.Name="Brilho" />

                <!-- Contraste -->
                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Contraste" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding ContrastText}" Style="{StaticResource ValueText}" />
                </Grid>
                <Slider Style="{StaticResource AppSlider}" Minimum="0" Maximum="100"
                        Value="{Binding Contrast, Mode=TwoWay}" Margin="0,6,0,0"
                        AutomationProperties.Name="Contraste" />

                <!-- Temperatura -->
                <Grid Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Temperatura" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="7,0,0,0">
                            <TextBlock Text="Pro" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource ValueText}" />
                </Grid>
                <Slider Style="{StaticResource TemperatureSlider}" Minimum="1900" Maximum="10000"
                        Value="{Binding Temperature, Mode=TwoWay}" Margin="0,6,0,0"
                        AutomationProperties.Name="Temperatura" />

                <!-- Botoes -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Configuracoes" Style="{StaticResource SecondaryButton}"
                            Height="40" Click="Settings_Click" />
                    <Button Grid.Column="2" Content="Restaurar niveis" Style="{StaticResource SecondaryButton}"
                            Height="40" Click="Reset_Click" />
                </Grid>

                <!-- Niveis de preto e branco -->
                <Border Margin="0,16,0,0" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="ToggleLevels_Click">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Niveis" Style="{StaticResource LabelText}" />
                            <TextBlock Text="preto e branco maximos" Style="{StaticResource HintText}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LevelsSummary}" Style="{StaticResource ValueText}" />
                            <Path Data="M 0 0 L 4.5 4.5 L 9 0"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LevelsExpanded}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="LevelsPanel" Visibility="{Binding LevelsVisibility}" Margin="0,4,0,0">
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Preto maximo" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                        <TextBox x:Name="BlackLevelBox" Style="{StaticResource HexBox}"
                                 Text="{Binding BlackLevelText, Mode=OneWay}"
                                 KeyDown="BlackLevelBox_KeyDown" LostFocus="BlackLevelBox_LostFocus"
                                 ToolTip="Digite o codigo: #000000, #202020, #RGB ou um nivel em hexadecimal" />
                    </Grid>
                    <Slider Style="{StaticResource LevelSlider}" Minimum="0" Maximum="160"
                            Value="{Binding BlackLevel, Mode=TwoWay}" Margin="0,6,0,0"
                            AutomationProperties.Name="Preto maximo" />

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Branco maximo" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                        <TextBox x:Name="WhiteLevelBox" Style="{StaticResource HexBox}"
                                 Text="{Binding WhiteLevelText, Mode=OneWay}"
                                 KeyDown="WhiteLevelBox_KeyDown" LostFocus="WhiteLevelBox_LostFocus"
                                 ToolTip="Digite o codigo: #FFFFFF, #DCDCDC, #RGB ou um nivel em hexadecimal" />
                    </Grid>
                    <Slider Style="{StaticResource LevelSlider}" Minimum="{Binding WhiteLevelMinimum}" Maximum="255"
                            Value="{Binding WhiteLevel, Mode=TwoWay}" Margin="0,6,0,0"
                            AutomationProperties.Name="Branco maximo" />

                    <TextBlock Style="{StaticResource HintText}" Margin="2,8,0,0"
                               Text="Digite o codigo e pressione Enter. Preto #000000 libera preto puro; #202020 mantem o piso cinza." />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
